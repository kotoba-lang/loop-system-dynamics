   :state :implemented-unwired
   :source "orgs/kotoba-lang/nekko/README.md; ADR-2607072200 (50 tests / 76 assertions)"}
  {:id :miki :what "the 'trunk' slot in the tree-motif naming table"
   :state :does-not-exist
   :source "ADR-2607161801 addendum: the git slot was resolved to `bonsai`, not `miki`; `miki` remains a RESERVED WORD with no repository behind it. grep 'name: mik' manifest/west.yml -> only com-etzhayyim-app-omikuji / com-etzhayyim-mikurabe, unrelated"}
  {:id :kagami-fleet-db :what "west.yml <-> fleet-db bijective import, signed pin-advance, parallel `fleet sync`"
   :state :phase-0-landed-phase-1-pending
   :source "ADR-2607160005 addendum: byte-identical round trip over the real west.yml verified; signed pins (Phase 1) not landed; the absorbing CI was removed 2026-07-30"}
  {:id :semantic-code :what "Unison-shaped content-addressed DEFINITION identity: DAG-CBOR CIDv1 per checked def, de Bruijn binders, dependency CIDs propagate, CID-addressed namespace commits"
   :state :local-kernel-implemented-no-network
   :source "orgs/kotoba-lang/kotoba/docs/ADR-kotoba-content-addressed-codebase-gap.md (2026-07-23): 'Do not claim a deployed codebase network, signed-record distribution, or availability guarantees'"}
  {:id :inga :what "chained-HotStuff BFT: n=3f+1, 2f+1 quorum certificates, pacemaker, signed attestations, real WebSocket transport, stake-weighted quorum"
   :state :implemented-3166-lines-not-wired-to-repo-refs
   :source "ADR-2608038000 (2026-08-03), engi@a6d4450 namespace line counts"}
  {:id :nix-shaped-supply-chain :what "content-address pinning of external deps with fail-closed validation (aiueos TCB inventory v2)"
   :state :implemented-for-aiueos-only
   :source "ADR-2608012050 (2026-08-01): literal nix/flake usage is 0 files; the properties were reached independently, for one repo's TCB"}]

 ;; --------------------------------------------------------------------------
 ;; NOT MEASURED -- named so nothing downstream silently treats them as zero
 ;; --------------------------------------------------------------------------
 :unmeasured
 {:agent-edit-to-landed-latency "no instrumentation exists that timestamps an agent's first edit and the merge of the commit containing it"
  :manifest-write-conflict-rate "409 rates on the single-entry west.yml PUT path are not logged anywhere; ADR-2607258000 records that the registration path emptied west.yml twice, which is evidence the path fails, not a rate"
  :concurrent-agent-count "the number of terminals/agents live at any moment is not recorded"
  :cross-machine-drift "this snapshot is one workstation; a second machine's checkouts were not probed"}}
