;; re-generated and diffed while the other carries signed judgment.
{:as-of "2026-08-03"
 :subject "com-junkawasaki/root west/git fleet + kotoba-lang VCS suite (bonsai/nekko/kagami) + radicle storage"
 :host "owner workstation (darwin 25.3.0), single machine -- a second terminal/machine has its own drift and is not measured here"

 ;; --------------------------------------------------------------------------
 ;; PLANES -- independent representations of 'where is the code'
 ;; --------------------------------------------------------------------------
 :planes
 [{:id :local-worktrees :role "materialised child checkouts under orgs/<org>/<repo>" :live? true}
  {:id :github-west :role "manifest/west.yml pins + GitHub refs -- today's source of truth" :live? true}
  {:id :radicle :role "per-writer namespaces + sigrefs in ~/.radicle/storage" :live? true
   :note "CORRECTED 2026-08-04. This was recorded as a write-once plane that had drifted; measuring the DIRECTION of the divergence over 556 repos inverted that reading -- rad-behind 0.2% (1 repo) against rad-ahead 3.8%, i.e. the plane is overwhelmingly FRESHER than the local checkouts, and other sessions on this machine keep pushing to it (8-9 repos updated in the 12h to 2026-08-04 04:09). It is :live? true. The node is still stopped, so it does not REPLICATE between machines -- but locally it is maintained, not abandoned. `rad node status` -> stopped on 2026-08-03/04. Wiring it was chosen by the owner the same day; the prerequisite visibility audit passed (3,676 of 3,677 repos are public-visibility and ZERO correspond to a repo that is private on GitHub), but `rad node start` needs the passphrase for this machine's identity (alias junkawasaki, did:key:z6MkpPKis...) and a targeted lookup found it in neither kagi nor the macOS Keychain. Blocked on one owner action: `rad auth`, then store it as kagi personal/radicle-junkawasaki-passphrase."}
  {:id :fleet-db :role "manifest/fleet-db.edn + append-only ledger (kagami) -- CLAUDE.md declares this west.yml's upstream" :live? true
   :note "live again on 2026-08-03: `fleet reconcile` absorbed 629 changed pins / 499 added / 201 removed as 1,329 attributed ledger events and `--check` is clean. It had not moved since 2026-07-26."}]

 ;; --------------------------------------------------------------------------
 ;; RECONCILERS -- one row per pair anyone has ever claimed to keep in step.
 ;; :exists? = a command can answer 'are these two in step'.
 ;; :scheduled? = it runs without a person typing it. That second column is the
 ;; one that matters, and it is the one that is empty.
 ;; --------------------------------------------------------------------------
 :reconcilers
 [{:pair [:github-west :local-worktrees] :exists? true :scheduled? false
   :how "scripts/fleet-sync-probe.cljs (:head-vs-pin, :pin-behind-origin) + .claude/hooks/west-pin-verify-guard.cljs on the write path"}
  {:pair [:github-west :fleet-db] :exists? true :scheduled? false
   :how "`fleet reconcile --check` / `fleet reconcile` (kagami). The GitHub Action that ran it was removed 2026-07-30 (ADR-2607300900)."}
  {:pair [:radicle :local-worktrees] :exists? true :scheduled? false
   :how "scripts/fleet-sync-probe.cljs (:radicle) -- as of 2026-08-04 it compares each repo's rad canonical against ITS OWN checkout by ancestry and reports :rad-behind / :rad-ahead / :rad-commit-absent-locally / :diverged separately. The first version reported one undirected number and therefore blamed the radicle plane for what was a stale local checkout."}
  {:pair [:radicle :github-west] :exists? false :scheduled? false
   :how "the old :matches-pin-only bucket claimed to cover this pair but was an artefact of undirected matching; with direction-aware classification nothing compares rad against the manifest pin. Honest downgrade, not a regression in capability."}
  {:pair [:radicle :fleet-db] :exists? false :scheduled? false}
  {:pair [:fleet-db :local-worktrees] :exists? false :scheduled? false
   :how "nothing checks a checkout against fleet-db directly; it is only ever compared through the west.yml projection"}]

